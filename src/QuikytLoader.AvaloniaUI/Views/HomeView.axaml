<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuikytLoader.AvaloniaUI.ViewModels"
             xmlns:vq="using:QuikytLoader.AvaloniaUI.Views.Queue"
             xmlns:views="using:QuikytLoader.AvaloniaUI.Views"
             x:Class="QuikytLoader.AvaloniaUI.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="40">

        <views:YoutubeUrlInputCardView Grid.Row="0" />

        <vq:QueueListView Grid.Row="1" Margin="0,24,0,0" />

        <views:MessageInfoView Grid.Row="2" />

    </Grid>

</UserControl>
