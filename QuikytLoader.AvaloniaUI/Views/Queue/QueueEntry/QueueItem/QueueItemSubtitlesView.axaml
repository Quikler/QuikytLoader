<UserControl xmlns="https://github.com/avaloniaui"
             x:Name="QueueItemSubtitlesViewName"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmqes="using:QuikytLoader.AvaloniaUI.ViewModels.Queue.QueueEntry.Subtitles"
             xmlns:vcommon="using:QuikytLoader.AvaloniaUI.Views.Common"
             xmlns:enums="using:QuikytLoader.Domain.Enums"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:common="using:QuikytLoader.Domain.Common"
             x:Class="QuikytLoader.AvaloniaUI.Views.Queue.QueueEntry.QueueItem.QueueItemSubtitlesView"
             x:DataType="vmqes:QueueItemSubtitlesViewModel"
             IsVisible="{Binding AreSubtitlesVisible}">

    <Border Classes="QueueItemBorderBottom">
        <Grid RowDefinitions="Auto,Auto">

            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="4">

                <!-- Tabs -->
                <TabStrip Grid.Row="0"
                          ItemsSource="{Binding SubtitleTabs}"
                          SelectedItem="{Binding SelectedTab}"
                          IsVisible="{Binding SubtitleTabs, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="vmqes:TabItemViewModel">
                            <TextBlock Text="{Binding Header}" />
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>

                <ContentControl Grid.Row="1"
                                Content="{Binding SubtitleState}">
                    <ContentControl.DataTemplates>

                        <DataTemplate DataType="{x:Type vmqes:SubtitleLoadingState}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <ProgressBar IsIndeterminate="True"
                                             Width="200"/>

                                <Grid HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ColumnSpacing="4"
                                      ColumnDefinitions="Auto,*">
                                    <Button Command="{Binding #QueueItemSubtitlesViewName.DataContext.CancelSubtitlesCommand}"
                                            FontWeight="SemiBold"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <ui:FASymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                         Symbol="Cancel"
                                                         FontSize="18"/>
                                    </Button>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LoadingMessage}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vmqes:SubtitleLanguageSelectionState}">
                            <vcommon:TextWithDetails Message="{Binding Message}"
                                                     MessageForeground="{DynamicResource SystemFillColorNeutralBrush}"
                                                     DetailsMessage="{Binding DetailsMessage}">
                                <vcommon:TextWithDetails.LeftSideActionContent>
                                    <Button Command="{Binding #QueueItemSubtitlesViewName.DataContext.FetchSubtitlesWithLanguageWorkflowCommand}"
                                            FontWeight="SemiBold"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <ui:FASymbolIcon Foreground="{DynamicResource SystemFillColorNeutralBrush}"
                                                         Symbol="Checkmark"
                                                         FontSize="18"/>
                                    </Button>
                                </vcommon:TextWithDetails.LeftSideActionContent>

                                <vcommon:TextWithDetails.RightSideContent>
                                    <ComboBox ItemsSource="{x:Static common:Language.Options}"
                                              SelectedItem="{Binding #QueueItemSubtitlesViewName.DataContext.SelectedAutoSubtitlesLanguage, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="common:Language">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </vcommon:TextWithDetails.RightSideContent>
                            </vcommon:TextWithDetails>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vmqes:SubtitleRetryLanguageSelectionState}">
                            <vcommon:TextWithDetails Message="{Binding Message}"
                                                     MessageForeground="{DynamicResource SystemFillColorCriticalBrush}"
                                                     DetailsMessage="{Binding DetailsMessage}">
                                <vcommon:TextWithDetails.LeftSideActionContent>
                                    <Button Command="{Binding #QueueItemSubtitlesViewName.DataContext.FetchSubtitlesWithLanguageWorkflowCommand}"
                                            FontWeight="SemiBold"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <ui:FASymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                         Symbol="Refresh"
                                                         FontSize="18"/>
                                    </Button>
                                </vcommon:TextWithDetails.LeftSideActionContent>

                                <vcommon:TextWithDetails.RightSideContent>
                                    <ComboBox ItemsSource="{x:Static common:Language.Options}"
                                              SelectedItem="{Binding #QueueItemSubtitlesViewName.DataContext.SelectedAutoSubtitlesLanguage, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="common:Language">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </vcommon:TextWithDetails.RightSideContent>
                            </vcommon:TextWithDetails>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vmqes:SubtitleChangeAutoSubtitlesOptionState}">
                            <vcommon:TextWithDetails Message="{Binding Message}"
                                                     MessageForeground="{DynamicResource SystemFillColorCriticalBrush}"
                                                     DetailsMessage="{Binding DetailsMessage}">
                                <vcommon:TextWithDetails.LeftSideActionContent>
                                    <Button Command="{Binding #QueueItemSubtitlesViewName.DataContext.FetchSubtitlesWorkflowCommand}"
                                            FontWeight="SemiBold"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <ui:FASymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                         Symbol="Refresh"
                                                         FontSize="18"/>
                                    </Button>
                                </vcommon:TextWithDetails.LeftSideActionContent>

                                <vcommon:TextWithDetails.RightSideContent>
                                    <Grid ColumnDefinitions="Auto,Auto"
                                          ColumnSpacing="4">
                                        <ComboBox ItemsSource="{x:Static enums:DomainEnums.AutoSubtitlesOptions}"
                                                  SelectedItem="{Binding #QueueItemSubtitlesViewName.DataContext.SettingsViewModel.AutoSubtitlesOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding, Converter={StaticResource EnumToSpacedStringConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        
                                        <Button Grid.Column="1"
                                                Content="Save"
                                                Command="{Binding #QueueItemSubtitlesViewName.DataContext.SettingsViewModel.SaveSettingsCommand}"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                Foreground="White"
                                                FontSize="14"
                                                FontWeight="SemiBold"/>
                                    </Grid>
                                </vcommon:TextWithDetails.RightSideContent>
                            </vcommon:TextWithDetails>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vmqes:SubtitleAutoSubtitlesOptionSettingsChangedState}">
                            <vcommon:TextWithDetails Message="{Binding Message}"
                                                     MessageForeground="{DynamicResource SystemFillColorNeutralBrush}">
                                <vcommon:TextWithDetails.LeftSideActionContent>
                                    <Button Command="{Binding #QueueItemSubtitlesViewName.DataContext.FetchSubtitlesWorkflowCommand}"
                                            FontWeight="SemiBold"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <ui:FASymbolIcon Foreground="{DynamicResource SystemFillColorNeutralBrush}"
                                                         Symbol="Refresh"
                                                         FontSize="18"/>
                                    </Button>
                                </vcommon:TextWithDetails.LeftSideActionContent>
                            </vcommon:TextWithDetails>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vmqes:SubtitleErrorState}">
                            <vcommon:TextWithDetails Message="{Binding Message}"
                                                     MessageForeground="{DynamicResource SystemFillColorCriticalBrush}"
                                                     DetailsMessage="{Binding DetailsMessage}">
                                <vcommon:TextWithDetails.LeftSideActionContent>
                                    <Button Command="{Binding #QueueItemSubtitlesViewName.DataContext.FetchSubtitlesWorkflowCommand}"
                                            FontWeight="SemiBold"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            IsVisible="{Binding AllowRetry}">
                                        <ui:FASymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                         Symbol="Refresh"
                                                         FontSize="18"/>
                                    </Button>
                                </vcommon:TextWithDetails.LeftSideActionContent>
                            </vcommon:TextWithDetails>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vmqes:SubtitleSuccessState}">
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vmqes:SubtitleIdleState}">
                        </DataTemplate>

                    </ContentControl.DataTemplates>
                </ContentControl>

            </Grid>

            <ContentControl Grid.Row="1"
                            Content="{Binding SelectedTab}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vmqes:TabItemViewModel">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <SelectableTextBlock Text="{Binding Content}"
                                                 TextWrapping="NoWrap"
                                                 Padding="0,16"/>
                        </ScrollViewer>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

        </Grid>
    </Border>

</UserControl>
