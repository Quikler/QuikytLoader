<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmqe="using:QuikytLoader.AvaloniaUI.ViewModels.Queue.QueueEntry"
             xmlns:vqeqi="using:QuikytLoader.AvaloniaUI.Views.Queue.QueueEntry.QueueItem"
             xmlns:enums="using:QuikytLoader.Domain.Enums"
             x:Class="QuikytLoader.AvaloniaUI.Views.Queue.QueueEntry.QueueItem.QueueItemView"
             x:DataType="vmqe:QueueItemViewModel"
             IsEnabled="{Binding Status, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static enums:DownloadStatus.Disabled}}">

    <StackPanel>

        <Border Classes="QueueItemBorder">
            <vqeqi:QueueItemBodyView />
        </Border>

        <vqeqi:QueueItemSubtitlesView />

    </StackPanel>

</UserControl>
