<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmqe="using:QuikytLoader.AvaloniaUI.ViewModels.Queue.QueueEntry"
             xmlns:vqeqi="using:QuikytLoader.AvaloniaUI.Views.Queue.QueueEntry.QueueItem"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="QuikytLoader.AvaloniaUI.Views.Queue.QueueEntry.QueueItem.SelectableQueueItemView"
             x:DataType="vmqe:SelectableQueueItemViewModel">

    <StackPanel>

        <Border Classes="QueueItemBorder">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          IsEnabled="{Binding IsSelectable}"
                          VerticalAlignment="Center"/>
        
                <vqeqi:QueueItemBodyView Grid.Column="1" />
            </Grid>
        </Border>

        <vqeqi:QueueItemSubtitlesView DataContext="{Binding QueueItemSubtitlesViewModel}" />

    </StackPanel>

</UserControl>
