<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuikytLoader.AvaloniaUI.ViewModels"
             xmlns:views="using:QuikytLoader.AvaloniaUI.Views"
             xmlns:qi="using:QuikytLoader.AvaloniaUI.Views.QueueItem"
             x:Class="QuikytLoader.AvaloniaUI.Views.QueueGroupView"
             x:DataType="vm:QueueGroupViewModel">

    <!-- Playlist: Expander with header + batch button -->
    <Expander IsExpanded="{Binding IsExpanded}"
              HorizontalAlignment="Stretch">

        <Expander.Styles>
            <Style Selector="ToggleButton">
                <Setter Property="Background"
                        Value="{DynamicResource ExpanderHeaderBrush}" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch" />
                <Setter Property="BorderThickness"
                        Value="0" />
            </Style>
        </Expander.Styles>

        <Expander.Header>
            <views:QueueGroupHeaderView />
        </Expander.Header>

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:SelectableQueueItemViewModel">
                    <qi:SelectableQueueItemView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Expander>
</UserControl>
