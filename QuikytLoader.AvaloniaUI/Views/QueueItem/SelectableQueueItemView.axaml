<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmqe="using:QuikytLoader.AvaloniaUI.ViewModels.Queue.QueueEntry"
             xmlns:local="using:QuikytLoader.AvaloniaUI.Views"
             xmlns:enums="using:QuikytLoader.Domain.Enums"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:qi="using:QuikytLoader.AvaloniaUI.Views.QueueItem"
             x:Class="QuikytLoader.AvaloniaUI.Views.QueueItem.SelectableQueueItemView"
             x:DataType="vmqe:SelectableQueueItemViewModel">

    <StackPanel>

        <Border Classes="QueueItemBorder">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          IsEnabled="{Binding IsSelectable}"
                          VerticalAlignment="Center"/>
        
                <qi:QueueItemBodyView Grid.Column="1" />
            </Grid>
        </Border>

        <qi:QueueItemSubtitlesView />

    </StackPanel>

</UserControl>
