<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuikytLoader.AvaloniaUI.ViewModels"
             xmlns:local="using:QuikytLoader.AvaloniaUI.Views"
             xmlns:enums="using:QuikytLoader.Domain.Enums"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:qi="using:QuikytLoader.AvaloniaUI.Views.QueueItem"
             x:Class="QuikytLoader.AvaloniaUI.Views.QueueItem.SelectableQueueItemView"
             x:DataType="vm:SelectableQueueItemViewModel">

    <Border Classes="QueueItemBorder">
        <StackPanel Spacing="8">

            <Grid ColumnDefinitions="Auto,*">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          IsEnabled="{Binding IsSelectable}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
        
                <qi:QueueItemBodyView Grid.Column="1" />
            </Grid>

            <qi:QueueItemSubtitlesView />

        </StackPanel>
    </Border>

</UserControl>
