<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuikytLoader.AvaloniaUI.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="QuikytLoader.AvaloniaUI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="24" Margin="40">

            <!-- Settings Header -->
            <StackPanel Spacing="8">
                <TextBlock Text="Settings"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Configure application theme and Telegram bot connection"
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Youtube Configuration Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="24">

                    <!-- Card Title -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Youtube Configuration"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Choose your preferred Youtube settings"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24">
                        <StackPanel Spacing="24">

                            <!-- Card Title -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Auto Subtitles"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Choose your preferred setting to manage auto subtitles"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <ListBox
                                    ItemsSource="{Binding AutoSubtitlesOptions}"
                                    SelectedItem="{Binding AutoSubtitlesOption}"
                                    Classes="RadioButtonListBox" />
                            </StackPanel>

                        </StackPanel>

                    </Border>
                </StackPanel>
            </Border>

            <!-- Theme Configuration Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="24">

                    <!-- Card Title -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Theme Configuration"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Choose your preferred application theme"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Theme Preferences -->
                    <StackPanel Spacing="8">
                        <ListBox
                            ItemsSource="{Binding ThemePreferences}"
                            SelectedItem="{Binding ThemePreference}"
                            Classes="RadioButtonListBox" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Telegram Bot Configuration Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="24">

                    <!-- Card Title -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Telegram Bot Configuration"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Enter your Telegram bot credentials to send downloaded files"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Bot Token Input -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Bot Token"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <TextBox Text="{Binding BotToken, Mode=TwoWay}"
                                 PlaceholderText="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
                                 FontSize="14"
                                 Height="40"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <Run Text="Get your bot token from"/>
                            <Run Text="@BotFather" FontWeight="SemiBold"/>
                            <Run Text="on Telegram"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Chat ID Input -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Chat ID"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <TextBox Text="{Binding ChatId, Mode=TwoWay}"
                                 PlaceholderText="123456789"
                                 FontSize="14"
                                 Height="40"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <Run Text="Your Telegram chat ID. Use"/>
                            <Run Text="@userinfobot" FontWeight="SemiBold"/>
                            <Run Text="to find your chat ID"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Save Button and Status -->
            <StackPanel Spacing="12">
                <Button Content="Save Settings"
                        Command="{Binding SaveSettingsCommand}"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="White"
                        IsEnabled="{Binding HasUnsavedChanges}"
                        HorizontalAlignment="Left"
                        Height="40"
                        Padding="24,0"
                        FontSize="14"
                        FontWeight="SemiBold"/>

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="13"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>


            <!-- Help Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="24">

                    <!-- Card Title -->
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="How to set up your Telegram bot"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:FASymbolIcon Symbol="Help"
                                       FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                    </StackPanel>

                    <!-- Instructions -->
                    <StackPanel Spacing="12" Margin="28,0,0,0">
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="1. Open Telegram and search for"/>
                            <Run Text="@BotFather" FontWeight="SemiBold"/>
                        </TextBlock>

                        <TextBlock Text="2. Send /newbot and follow the instructions"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <TextBlock Text="3. Copy the bot token and paste it above"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <TextBlock TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="4. Search for"/>
                            <Run Text="@userinfobot" FontWeight="SemiBold"/>
                            <Run Text="to get your chat ID"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
