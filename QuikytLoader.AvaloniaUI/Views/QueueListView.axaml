<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuikytLoader.AvaloniaUI.ViewModels"
             xmlns:models="using:QuikytLoader.AvaloniaUI.Models"
             xmlns:local="using:QuikytLoader.AvaloniaUI.Views"
             xmlns:enums="using:QuikytLoader.Domain.Enums"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:views="using:QuikytLoader.AvaloniaUI.Views"
             x:Class="QuikytLoader.AvaloniaUI.Views.QueueListView"
             x:DataType="vm:QueueListViewModel">

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsVisible="{Binding QueueManager.QueueEntries.Count}">
        <StackPanel>
            <!-- Queue Header -->
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    Padding="16,12"
                    CornerRadius="8,8,0,0">
                <TextBlock Text="Download Queue"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Border>

            <!-- Queue Items -->
            <Grid>
                <ScrollViewer x:Name="QueueScroll"
                              MaxHeight="400"
                              ScrollChanged="QueueScroll_ScrollChanged">
                    <ItemsControl x:Name="QueueItems"
                                  ItemsSource="{Binding QueueManager.QueueEntries}">
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:QueueGroupViewModel">
                                <views:QueueGroupView/>
                            </DataTemplate>
                            <DataTemplate DataType="vm:QueueItemViewModel">
                                <Border Classes="QueueItemBorder">
                                    <views:QueueItemView/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Sticky header -->
                <Expander IsExpanded="{Binding StickyQueueGroup.IsExpanded}"
                          Background="Transparent"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding StickyQueueGroup, Converter={x:Static ObjectConverters.IsNotNull}}">

                    <Expander.Styles>
                        <Style Selector="ToggleButton">
                            <Setter Property="Background"
                                    Value="{DynamicResource ExpanderHeaderBrush}" />
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                            <Setter Property="BorderThickness"
                                    Value="0" />
                        </Style>

                        <Style Selector="Expander">
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <DockPanel MinWidth="{TemplateBinding MinWidth}"
                                               MaxWidth="{TemplateBinding MaxWidth}">
                                        <!-- Only leave ToggleButton since we don't need Content -->
                                        <ToggleButton Name="ExpanderHeader"
                                                      MinHeight="{TemplateBinding MinHeight}"
                                                      IsEnabled="{TemplateBinding IsEnabled}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"
                                                      IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}" />
                                    </DockPanel>
                                </ControlTemplate>
                            </Setter>
                        </Style>
                    </Expander.Styles>

                    <Expander.Header>
                        <views:QueueGroupHeaderView DataContext="{Binding StickyQueueGroup}" />
                    </Expander.Header>

                </Expander>
            </Grid>
        </StackPanel>
    </Border>

</UserControl>
