<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuikytLoader.AvaloniaUI.ViewModels"
             xmlns:models="using:QuikytLoader.AvaloniaUI.Models"
             xmlns:local="using:QuikytLoader.AvaloniaUI.Views"
             xmlns:enums="using:QuikytLoader.Domain.Enums"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:views="using:QuikytLoader.AvaloniaUI.Views"
             x:Class="QuikytLoader.AvaloniaUI.Views.QueueListView"
             x:DataType="vm:QueueListViewModel">

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsVisible="{Binding QueueManager.QueueEntries.Count}">
        <StackPanel>
            <!-- Queue Header -->
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    Padding="16,12"
                    CornerRadius="8,8,0,0">
                <TextBlock Text="Download Queue"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Border>

            <!-- Queue Items -->
            <ScrollViewer MaxHeight="400">
                <ItemsControl ItemsSource="{Binding QueueManager.QueueEntries}">
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="{x:Type vm:QueueItemViewModel}">
                            <views:QueueItemView />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:QueueGroupViewModel}">
                            <views:QueueGroupView />
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>

</UserControl>
