<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuikytLoader.AvaloniaUI.ViewModels"
             xmlns:models="using:QuikytLoader.AvaloniaUI.Models"
             xmlns:local="using:QuikytLoader.AvaloniaUI.Views"
             xmlns:enums="using:QuikytLoader.Domain.Enums"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:views="using:QuikytLoader.AvaloniaUI.Views"
             xmlns:common="using:QuikytLoader.Domain.Common"
             x:Class="QuikytLoader.AvaloniaUI.Views.QueueItemView"
             x:DataType="vm:QueueItemViewModel"
             IsEnabled="{Binding Status, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static enums:DownloadStatus.Disabled}}"
             ToolTip.Tip="{Binding Url}">

    <StackPanel Spacing="8">

        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">

            <!-- Video Thumbnail -->
            <Grid Width="120" Height="68"
                  Margin="0,0,12,0">
                <!-- Placeholder when image hasn't loaded by URL yet -->
                <Border CornerRadius="4"
                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                    <ui:FASymbolIcon Symbol="Video"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>

                <!-- Thumbnail with duration overlay -->
                <Panel>
                    <Border CornerRadius="4" ClipToBounds="True">
                        <Image Stretch="UniformToFill"
                               asyncImageLoader:ImageLoader.Source="{Binding CoverThumbnailUrl}"/>
                    </Border>
                    <!-- Duration overlay -->
                    <Border Background="#CC000000"
                            CornerRadius="3"
                            Padding="4,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,4,4"
                            IsVisible="{Binding Duration, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Duration}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                </Panel>
            </Grid>

            <Grid Grid.Column="1"
                  ColumnDefinitions="*,Auto"
                  VerticalAlignment="Stretch">

                <StackPanel>
                    <Grid Margin="0,0,4,0">
                       <TextBlock Text="{Binding Title, FallbackValue=''}"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  TextTrimming="CharacterEllipsis"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  HorizontalAlignment="Stretch"
                                  IsVisible="{Binding !CanEdit}" />

                       <TextBox Text="{Binding CustomTitle, Mode=TwoWay}"
                                PlaceholderText="Edit title..."
                                FontSize="13"
                                IsVisible="{Binding CanEdit}" />
                    </Grid>

                    <StackPanel>
                        <TextBlock Text="{Binding Channel}"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   IsVisible="{Binding Channel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4">
                    <!-- Proceed or Cancel button -->
                    <Grid VerticalAlignment="Top">
                        <Button Command="{Binding ProceedCommand}"
                                Padding="8,4"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Background="#90EE90"
                                Foreground="#2D5016"
                                IsVisible="{Binding CanProceed}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ui:FASymbolIcon Symbol="Play" FontSize="11"/>
                                <TextBlock Text="Proceed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelCommand}"
                                Padding="8,4"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Background="#E74C3C"
                                Foreground="White"
                                IsVisible="{Binding CanCancel}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ui:FASymbolIcon Symbol="Cancel" FontSize="11"/>
                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DockPanel>
                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="4" DockPanel.Dock="Top"
                                Padding="8,4">
                            <TextBlock Text="{Binding Status}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>

                        <Button Command="{Binding ToggleSubtitlesCommand}"
                                FontWeight="SemiBold"
                                Padding="0"
                                DockPanel.Dock="Bottom"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ui:FASymbolIcon Symbol="{Binding SubtitlesChevronSymbol}" FontSize="16"/>
                                <ui:FASymbolIcon Symbol="{Binding SubtitlesIconSymbol}" FontSize="32"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </StackPanel>

            </Grid>

            <ProgressBar Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Value="{Binding Progress}"
                         Maximum="100"
                         Height="4"
                         Margin="0,8,0,0"
                         IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:DownloadStatus.Downloading}}"
                         ShowProgressText="False"/>

            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="2"
                       Text="{Binding ErrorMessage}"
                       FontSize="11"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>

        <Grid IsVisible="{Binding AreSubtitlesVisible}">
            <!-- Loading -->
            <StackPanel IsVisible="{Binding AreSubtitlesLoading}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <ProgressBar IsIndeterminate="True"
                             Width="200"/>

                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ColumnSpacing="4"
                      ColumnDefinitions="Auto,*">
                    <Button Command="{Binding CancelSubtitlesCommand}"
                            FontWeight="SemiBold"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <ui:FASymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                         Symbol="Cancel"
                                         FontSize="18"/>
                    </Button>

                    <TextBlock Grid.Column="1"
                               Text="Loading subtitles..."
                               TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>

            <!-- Content -->
            <Grid IsVisible="{Binding !AreSubtitlesLoading}">

                <Grid ColumnDefinitions="*"
                      ColumnSpacing="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center">

                    <!-- Error -->
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="4"
                          HorizontalAlignment="Center"
                          IsVisible="{Binding SubtitlesErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Button Command="{Binding FetchSubtitlesCommand}"
                                FontWeight="SemiBold"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding AllowSubtitlesLoading}">
                            <ui:FASymbolIcon Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                             Symbol="Refresh"
                                             FontSize="18"/>
                        </Button>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding SubtitlesErrorMessage}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                    </Grid>

                    <!-- Information -->
                    <Grid Grid.Column="0"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="4"
                          HorizontalAlignment="Center"
                          IsVisible="{Binding AutoSubtitlesMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="4">
                            <Button Command="{Binding FetchSubtitlesCommand}"
                                    CommandParameter="{Binding #LanguagesComboBox.SelectedItem}"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsVisible="{Binding AllowSubtitlesLoading}">
                                <ui:FASymbolIcon Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                 Symbol="Checkmark"
                                                 FontSize="18"/>
                            </Button>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding AutoSubtitlesMessage}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        </Grid>

                        <ComboBox x:Name="LanguagesComboBox"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  ItemsSource="{x:Static common:Languages.All}"
                                  SelectedIndex="0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="common:Language">
                                    <TextBlock Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                </Grid>

                <TabControl ItemsSource="{Binding SubtitleTabs}"
                            IsVisible="{Binding SubtitleTabs, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TabItemViewModel">
                            <TextBlock Text="{Binding Header}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:TabItemViewModel">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <SelectableTextBlock Text="{Binding Content}"
                                                     TextWrapping="NoWrap"
                                                     Padding="0,16"/>
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Grid>

    </StackPanel>

</UserControl>
