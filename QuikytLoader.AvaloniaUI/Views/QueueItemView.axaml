<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuikytLoader.AvaloniaUI.ViewModels"
             xmlns:models="using:QuikytLoader.AvaloniaUI.Models"
             xmlns:local="using:QuikytLoader.AvaloniaUI.Views"
             xmlns:enums="using:QuikytLoader.Domain.Enums"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:views="using:QuikytLoader.AvaloniaUI.Views"
             x:Class="QuikytLoader.AvaloniaUI.Views.QueueItemView"
             x:DataType="vm:QueueItemViewModel"
             IsEnabled="{Binding Status, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static enums:DownloadStatus.Disabled}}"
             ToolTip.Tip="{Binding Url}">

    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">

        <Grid Width="120" Height="68"
              Margin="0,0,12,0">
            <!-- Placeholder when image hasn't loaded by URL yet -->
            <Border CornerRadius="4"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <ui:FASymbolIcon Symbol="Video"
                               FontSize="24"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
            </Border>

            <!-- Thumbnail with duration overlay -->
            <Panel>
                <Border CornerRadius="4" ClipToBounds="True">
                    <Image Stretch="UniformToFill"
                           asyncImageLoader:ImageLoader.Source="{Binding CoverThumbnailUrl}"/>
                </Border>
                <!-- Duration overlay -->
                <Border Background="#CC000000"
                        CornerRadius="3"
                        Padding="4,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,4,4"
                        IsVisible="{Binding Duration, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Duration}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </Border>
            </Panel>
        </Grid>

        <!-- Right side: title, channel, status -->
        <StackPanel Grid.Column="1">

            <Grid ColumnDefinitions="*,Auto"
                  VerticalAlignment="Center">

                <Grid VerticalAlignment="Center"
                      Margin="0,0,4,0">
                   <TextBlock Text="{Binding Title, FallbackValue=''}"
                              FontSize="13"
                              FontWeight="SemiBold"
                              TextTrimming="CharacterEllipsis"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              HorizontalAlignment="Stretch"
                              IsVisible="{Binding !CanEdit}" />

                   <TextBox Text="{Binding CustomTitle, Mode=TwoWay}"
                            Watermark="Edit title..."
                            FontSize="13"
                            IsVisible="{Binding CanEdit}" />
                </Grid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <!-- Proceed or Cancel button -->
                    <Grid>
                        <Button Command="{Binding ProceedCommand}"
                                Padding="8,4"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Background="#90EE90"
                                Foreground="#2D5016"
                                IsVisible="{Binding CanProceed}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ui:FASymbolIcon Symbol="Play" FontSize="11"/>
                                <TextBlock Text="Proceed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelCommand}"
                                Padding="8,4"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Background="#E74C3C"
                                Foreground="White"
                                IsVisible="{Binding CanCancel}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ui:FASymbolIcon Symbol="Cancel" FontSize="11"/>
                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="8,4">
                        <TextBlock Text="{Binding Status}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                </StackPanel>

            </Grid>

            <StackPanel>
                <TextBlock Text="{Binding Channel}"
                           FontSize="12"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsVisible="{Binding Channel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

        </StackPanel>

        <ProgressBar Grid.Row="1"
                     Grid.ColumnSpan="2"
                     Value="{Binding Progress}"
                     Maximum="100"
                     Height="4"
                     Margin="0,8,0,0"
                     IsVisible="{Binding Status, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:DownloadStatus.Downloading}}"
                     ShowProgressText="False"/>

        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Text="{Binding ErrorMessage}"
                   FontSize="11"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </Grid>

</UserControl>
