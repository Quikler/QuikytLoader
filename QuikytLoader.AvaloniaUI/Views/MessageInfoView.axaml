<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuikytLoader.AvaloniaUI.ViewModels"
             xmlns:models="using:QuikytLoader.AvaloniaUI.Models"
             xmlns:enums="using:QuikytLoader.Domain.Enums"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="QuikytLoader.AvaloniaUI.Views.MessageInfoView"
             x:DataType="vm:MessageInfoViewModel">

    <Border Margin="0,16,0,0"
            Padding="12,8"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            CornerRadius="6"
            IsVisible="{Binding MessageInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:SymbolIcon Symbol="Alert"
                           FontSize="16"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
            <TextBlock Text="{Binding MessageInfo}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </StackPanel>
    </Border>

</UserControl>
