<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuikytLoader.AvaloniaUI.ViewModels"
             xmlns:models="using:QuikytLoader.AvaloniaUI.Models"
             xmlns:local="using:QuikytLoader.AvaloniaUI.Views"
             xmlns:enums="using:QuikytLoader.Domain.Enums"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:views="using:QuikytLoader.AvaloniaUI.Views"
             x:Class="QuikytLoader.AvaloniaUI.Views.SelectableQueueItemView"
             x:DataType="vm:SelectableQueueItemViewModel">

    <DockPanel>
        <CheckBox DockPanel.Dock="Left"
                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                  IsEnabled="{Binding IsSelectable}"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0"/>
        
        <views:QueueItemView />
    </DockPanel>

</UserControl>
