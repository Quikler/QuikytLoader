<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="QuikytLoader.AvaloniaUI.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <sty:FluentAvaloniaTheme />
        <StyleInclude Source="avares://QuikytLoader.AvaloniaUI/Views/Styles/BorderStyles.axaml" />
        <StyleInclude Source="avares://QuikytLoader.AvaloniaUI/Views/Styles/ButtonStyles.axaml" />
        <StyleInclude Source="avares://QuikytLoader.AvaloniaUI/Views/Styles/RadioButtonStyles.axaml" />
    </Application.Styles>
</Application>
